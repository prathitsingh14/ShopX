import tkinter as tk
from tkinter import messagebox
from functools import reduce

BG, PANEL, CARD, FIELD = "#0B0D12", "#12151C", "#181C26", "#0F1218"
TEXT, MUTED, ACCENT, GOOD, BAD = "#E8EAF0", "#8A93A6", "#7C5CFF", "#34D399", "#F87171"

PRODUCTS = [("Wireless Headphones", 1499), ("Smart Watch", 2999), ("Bluetooth Speaker", 1299),
            ("Cotton T-Shirt", 499), ("Denim Jacket", 1799), ("Running Shoes", 2199),
            ("Coffee Mug", 249), ("Desk Lamp", 899), ("Notebook Set", 349)]
PRICE = dict(PRODUCTS)          # product name -> price


def delivery_cost(subtotal, express):
    """Pure function: same inputs always give the same answer, and nothing else changes."""
    base = 0 if subtotal >= 999 else 49
    return base + (99 if express else 0)


def label(parent, text, size=11, color=TEXT, bold=False):
    return tk.Label(parent, text=text, bg=parent["bg"], fg=color,
                    font=("Arial", size, "bold" if bold else "normal"))


def button(parent, text, command, color=ACCENT):
    return tk.Button(parent, text=text, command=command, bg=color, fg="white",
                     relief="flat", padx=10, pady=4)


class ShopX:
    def __init__(self, root):
        self.root = root
        self.user = None
        self.page = "shop"
        self.sidebar_open = True
        self.message = ""
        self.cart = {}                  # product name -> quantity
        self.orders = []                # each order is a dict
        self.search = tk.StringVar()
        self.name = tk.StringVar()
        self.phone = tk.StringVar()
        self.delivery = tk.IntVar(value=0)

        root.title("ShopX")
        root.geometry("900x560")
        root.configure(bg=BG)
        self.render()

    # ----- screen switching -----
    def go(self, page):
        self.page = page
        self.render()

    def render(self):
        """Clear the window and build the current screen again."""
        for widget in self.root.winfo_children():
            widget.destroy()
        if self.user is None:
            self.login_screen()
            return

        top = tk.Frame(self.root, bg=PANEL)
        top.pack(fill="x")
        button(top, "\u2261", self.toggle_sidebar, CARD).pack(side="left", padx=10, pady=8)
        label(top, self.page.capitalize(), 13, bold=True).pack(side="left")
        button(top, f"Cart ({sum(self.cart.values())})", lambda: self.go("billing"), CARD).pack(side="right", padx=10)

        body = tk.Frame(self.root, bg=BG)
        body.pack(fill="both", expand=True)
        if self.sidebar_open:
            self.sidebar(body)

        content = tk.Frame(body, bg=BG, padx=20, pady=15)
        content.pack(side="left", fill="both", expand=True)
        if self.message:
            label(content, self.message, color=GOOD).pack(anchor="w", pady=(0, 8))
            self.message = ""
        pages = {"shop": self.shop_page, "billing": self.billing_page, "dashboard": self.dashboard_page}
        pages[self.page](content)

    def toggle_sidebar(self):
        self.sidebar_open = not self.sidebar_open
        self.render()

    def sidebar(self, body):
        side = tk.Frame(body, bg=PANEL)
        side.pack(side="left", fill="y")
        label(side, "ShopX", 18, ACCENT, True).pack(anchor="w", padx=16, pady=16)
        for text, page in [("Shop", "shop"), ("Dashboard", "dashboard"), ("Billing", "billing")]:
            color = ACCENT if page == self.page else CARD
            button(side, text, lambda p=page: self.go(p), color).pack(fill="x", padx=12, pady=3)
        button(side, "Sign out", self.sign_out, CARD).pack(side="bottom", fill="x", padx=12, pady=12)

    # ----- login -----
    def login_screen(self):
        box = tk.Frame(self.root, bg=CARD, padx=30, pady=25)
        box.place(relx=0.5, rely=0.5, anchor="center")
        label(box, "ShopX", 24, ACCENT, True).pack()
        self.user_entry = tk.Entry(box, bg=FIELD, fg=TEXT, insertbackground=TEXT, width=28)
        self.user_entry.pack(pady=(14, 6), ipady=5)
        self.pass_entry = tk.Entry(box, show="*", bg=FIELD, fg=TEXT, insertbackground=TEXT, width=28)
        self.pass_entry.pack(pady=6, ipady=5)
        self.pass_entry.bind("<Return>", lambda e: self.sign_in())
        self.error = label(box, "", 9, BAD)
        self.error.pack()
        button(box, "Sign in", self.sign_in).pack(fill="x", pady=6)
        label(box, "Demo login: admin / shopx123", 9, MUTED).pack(pady=(8, 0))

    def sign_in(self):
        if self.user_entry.get() == "admin" and self.pass_entry.get() == "shopx123":
            self.user = "admin"
            self.message = "Welcome, admin"
            self.go("shop")
        else:
            self.error.config(text="Wrong username or password")

    def sign_out(self):
        self.user = None
        self.cart.clear()
        self.render()

    # ----- shop (product list) -----
    def shop_page(self, parent):
        label(parent, "Products", 16, bold=True).pack(anchor="w")
        search = tk.Entry(parent, textvariable=self.search, bg=FIELD, fg=TEXT,
                          insertbackground=TEXT, width=30)
        search.pack(anchor="w", pady=8, ipady=4)
        search.bind("<KeyRelease>", lambda e: self.render())    # live search

        text = self.search.get().lower()
        matches = list(filter(lambda item: text in item[0].lower(), PRODUCTS))
        for name, price in matches:
            row = tk.Frame(parent, bg=CARD, padx=12, pady=8)
            row.pack(fill="x", pady=3)
            label(row, name, bold=True).pack(side="left")
            label(row, f"Rs. {price}", color=ACCENT).pack(side="left", padx=14)
            button(row, "Add to cart", lambda n=name: self.add_to_cart(n)).pack(side="right")
        if not matches:
            label(parent, "No products found", color=MUTED).pack(anchor="w", pady=10)

    def add_to_cart(self, name):
        self.cart[name] = self.cart.get(name, 0) + 1
        self.message = f"Added {name}"
        self.render()

    # ----- billing -----
    def billing_page(self, parent):
        label(parent, "Billing", 16, bold=True).pack(anchor="w")
        if not self.cart:
            label(parent, "Your cart is empty.", color=MUTED).pack(anchor="w", pady=10)
            return

        for name, qty in self.cart.items():
            row = tk.Frame(parent, bg=CARD, padx=12, pady=8)
            row.pack(fill="x", pady=3)
            label(row, f"{name} x {qty}", bold=True).pack(side="left")
            label(row, f"Rs. {PRICE[name] * qty}", color=MUTED).pack(side="left", padx=14)
            button(row, "Remove", lambda n=name: self.remove(n), CARD).pack(side="right")

        subtotal = reduce(lambda acc, name: acc + PRICE[name] * self.cart[name], self.cart, 0)
        cost = delivery_cost(subtotal, self.delivery.get() == 1)
        label(parent, f"Subtotal Rs. {subtotal}   Delivery Rs. {cost}   Total Rs. {subtotal + cost}",
              bold=True).pack(anchor="w", pady=10)

        tk.Radiobutton(parent, text="Standard delivery", variable=self.delivery, value=0,
                       command=self.render, bg=BG, fg=TEXT, selectcolor=PANEL).pack(anchor="w")
        tk.Radiobutton(parent, text="Express delivery (+Rs. 99)", variable=self.delivery, value=1,
                       command=self.render, bg=BG, fg=TEXT, selectcolor=PANEL).pack(anchor="w")

        label(parent, "Your name", 9, MUTED).pack(anchor="w", pady=(10, 0))
        tk.Entry(parent, textvariable=self.name, bg=FIELD, fg=TEXT, insertbackground=TEXT,
                 width=30).pack(anchor="w", ipady=4)
        label(parent, "Phone (10 digits)", 9, MUTED).pack(anchor="w", pady=(8, 0))
        tk.Entry(parent, textvariable=self.phone, bg=FIELD, fg=TEXT, insertbackground=TEXT,
                 width=30).pack(anchor="w", ipady=4)
        button(parent, "Place order", self.place_order).pack(anchor="w", pady=12)

    def remove(self, name):
        self.cart.pop(name, None)
        self.render()

    def place_order(self):
        phone = self.phone.get().strip()
        if not self.name.get().strip() or not (phone.isdigit() and len(phone) == 10):
            messagebox.showerror("Check details", "Enter your name and a 10-digit phone number.")
            return
        subtotal = reduce(lambda acc, name: acc + PRICE[name] * self.cart[name], self.cart, 0)
        total = subtotal + delivery_cost(subtotal, self.delivery.get() == 1)
        self.orders.append({"items": sum(self.cart.values()), "total": total})
        self.cart.clear()
        self.name.set("")
        self.phone.set("")
        self.message = f"Order placed for Rs. {total}"
        self.go("dashboard")

    # ----- dashboard -----
    def dashboard_page(self, parent):
        revenue = reduce(lambda acc, o: acc + o["total"], self.orders, 0)
        label(parent, "Dashboard", 16, bold=True).pack(anchor="w")
        label(parent, f"Orders: {len(self.orders)}     Revenue: Rs. {revenue}").pack(anchor="w", pady=10)
        label(parent, "Recent orders", bold=True).pack(anchor="w")
        if not self.orders:
            label(parent, "No orders yet.", color=MUTED).pack(anchor="w")
        for line in map(lambda pair: f"Order {pair[0]}: {pair[1]['items']} items, Rs. {pair[1]['total']}",
                        reversed(list(enumerate(self.orders, 1)))):
            label(parent, line).pack(anchor="w")


if __name__ == "__main__":
    root = tk.Tk()
    ShopX(root)
    root.mainloop()
